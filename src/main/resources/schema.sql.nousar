CREATE TABLE IF NOT EXISTS aulas (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    nombre VARCHAR(255) NOT NULL
);

CREATE TABLE IF NOT EXISTS asignaturas (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    nombre VARCHAR(255) NOT NULL
);

CREATE TABLE IF NOT EXISTS alumnos (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    nombre VARCHAR(255) NOT NULL,
    email VARCHAR(255) NOT NULL,
    edad INTEGER,
    fecha_registro TIMESTAMP
);

CREATE TABLE IF NOT EXISTS clases (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    dia_semana VARCHAR(20),
    hora_desde VARCHAR(10),
    hora_hasta VARCHAR(10),
    id_asignatura BIGINT,
    id_aula BIGINT,
    CONSTRAINT fk_clase_asignatura FOREIGN KEY (id_asignatura) REFERENCES asignaturas(id),
    CONSTRAINT fk_clase_aula FOREIGN KEY (id_aula) REFERENCES aulas(id)
);

CREATE TABLE IF NOT EXISTS alumno_asignatura (
    alumno_id BIGINT NOT NULL,
    asignatura_id BIGINT NOT NULL,
    PRIMARY KEY (alumno_id, asignatura_id),
    CONSTRAINT fk_aa_alumno FOREIGN KEY (alumno_id) REFERENCES alumnos(id),
    CONSTRAINT fk_aa_asignatura FOREIGN KEY (asignatura_id) REFERENCES asignaturas(id)
);

CREATE TABLE IF NOT EXISTS alumno_clase (
    alumno_id BIGINT NOT NULL,
    clase_id BIGINT NOT NULL,
    PRIMARY KEY (alumno_id, clase_id),
    CONSTRAINT fk_ac_alumno FOREIGN KEY (alumno_id) REFERENCES alumnos(id),
    CONSTRAINT fk_ac_clase FOREIGN KEY (clase_id) REFERENCES clases(id)
);